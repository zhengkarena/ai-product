# Choose ONE of these providers (or set both - OpenAI will take priority).

# Option 1: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxx
# Optional: override model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Anthropic (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-xxxx
# Optional: override model (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: force a specific provider when both keys are set
# AI_PROVIDER=openai    # or "anthropic"

# Port (optional, defaults to 3000)
PORT=3000
